{
  "name": "express-amplify",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "tsup --watch --onSuccess \"node dist/index.cjs\"",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "postbuild": "chmod +x scripts/postbuild.sh && ./scripts/postbuild.sh"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "4.17.17",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^22.13.9",
    "chalk": "^5.4.1",
    "fs-extra": "^11.3.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "5.8.2"
  },
  "pakageManager": "pnpm@8.6.3",
  "engines": {
    "node": ">=20.0.0"
  }
}
